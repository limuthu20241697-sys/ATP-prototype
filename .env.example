# Copy to .env for local development. On Railway, set these in the service Variables tab.

# Postgres connection string.
# Railway: reference the linked Postgres service, e.g. ${{Postgres.DATABASE_URL}}
# Local/external: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Set to "true" ONLY when DATABASE_URL is a public/external URL that requires SSL
# (e.g. Railway's public connection string). Leave empty for Railway's internal URL
# or a local Postgres.
DATABASE_SSL=

# Secret used to download the subscriber list and the merch order export:
#   GET /api/subscribers.csv?token=YOUR_ADMIN_TOKEN
#   GET /api/merch/orders.csv?token=YOUR_ADMIN_TOKEN
# Use a long random string.
ADMIN_TOKEN=

# --- Merch store (Shopify) -------------------------------------------------
# Signing secret for the Shopify order webhooks. Shopify admin:
#   Settings > Notifications > Webhooks — subscribe to BOTH
#   "Order creation" and "Order payment", pointing at
#   https://anjunadeep.odeysse.com/api/merch/webhook
# Without this the webhook endpoint returns 503 and stores nothing.
SHOPIFY_WEBHOOK_SECRET=

# The Shopify PRIMARY domain that serves checkout. Must not be the
# *.myshopify.com host — that 301-redirects, and redirects drop UTM/GA params.
# Currently hard-coded in index.html (OA_SHOP_DOMAIN); kept here for reference
# and for when the checkout host is wired server-side.
SHOPIFY_CHECKOUT_DOMAIN=shop.anjunadeep.odeysse.com

# --- Payment slips (bank transfer) -----------------------------------------
# Cloudflare R2 holds the uploaded slip images. Slips are financial documents:
# they must NOT go on local disk, because Railway wipes the filesystem on every
# deploy and express.static(__dirname) would make anything in the repo publicly
# downloadable.
#
# Cloudflare dashboard > R2 > create bucket > Manage API tokens.
# Token permission: "Object Read & Write", scoped to this bucket only.
# The Secret Access Key is shown ONCE — copy it immediately.
# Free tier (10 GB, 1M writes/mo, free egress) covers this use case entirely.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anjunadeep-slips

# Odeysse WhatsApp number in FULL international format, digits only.
# No "+", no spaces, and drop the leading 0: 071 234 5678 -> 94712345678
WHATSAPP_NUMBER=

# Bank details shown on the slip upload page. Keep these identical to the
# "Payment instructions" text in Shopify's manual payment method.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=

# --- Shopify Admin API (optional) ------------------------------------------
# Lets the slip review page mark an order PAID in Shopify in one click, instead
# of the admin having to find the same order in the Shopify admin separately.
# Without these the page still works — it just says "mark the order paid there
# manually" and links straight to the order.
#
# Required scope either way: write_orders (nothing else).
#
# NOTE: a leaked write_orders credential exposes every order from the last 60
# days, including customer names, emails and addresses. Keep it here only.
SHOPIFY_STORE_DOMAIN=odeysse.myshopify.com

# Pick ONE of the two blocks below.
#
# (A) LEGACY — a custom app created in the Shopify admin BEFORE 1 Jan 2026.
#     Settings > Apps and sales channels > Develop apps > your app >
#     API credentials > "Reveal token once". Permanent, nothing expires.
SHOPIFY_ADMIN_TOKEN=

# (B) CURRENT — an app created at https://dev.shopify.com/dashboard/.
#     Those never show a token, only these two values (Settings tab). The
#     server exchanges them for a 24-hour token and refreshes it as needed.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
